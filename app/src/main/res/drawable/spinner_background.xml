<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Fehér háttér -->
    <solid android:color="#FFFFFF"/>
    <!-- Kerekített sarkok -->
    <corners android:radius="16dp"/>
    <!-- Vékony, világosszürke körvonal -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC"/>
    <!-- Belső padding, hogy ne legyen zsúfolt az elem tartalma -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
