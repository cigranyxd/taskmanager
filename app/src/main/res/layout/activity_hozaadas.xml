<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1F5FE"
    tools:context=".YourActivity">

    <!-- Felső Material Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#4FC3F7"
        app:title="Új Tranzakció"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="sans-serif-medium" />

    <!-- Görgethető tartalom -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Összeg input (modern TextInputLayout) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/osszegInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Összeg"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Spinner a kategóriákhoz (legördülő menü látható stílussal) -->
            <Spinner
                android:id="@+id/kategoriakSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- GridView a kategóriákhoz és ikonjaikhoz -->
            <GridView
                android:id="@+id/kategoriakGridView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:columnWidth="80dp"
                android:gravity="center"
                android:horizontalSpacing="16dp"
                android:numColumns="3"
                android:verticalSpacing="16dp" />

            <!-- Leírás input (modern TextInputLayout) -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp"
                android:layout_marginBottom="24dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/leirasInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Leírás" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Mentés gomb (MaterialButton) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mentesGomb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mentés"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                app:backgroundTint="#4FC3F7"
                android:textColor="#FFFFFF" />

            <!-- Tranzakció típusa Spinner (kategória után) -->
            <Spinner
                android:id="@+id/tranzakcioTipusSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@android:drawable/btn_dropdown" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
