<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1F5FE">  <!-- Nagyon világos kék háttér -->

    <!-- Toolbar modern, világoskék háttérrel -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#4FC3F7"
        app:title="Főoldal"
        app:titleTextColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="sans-serif-medium" />

    <!-- Egyenleg kártya, finom árnyékkal és lekerekített sarkakkal -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_balance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="#FFFFFF">

        <TextView
            android:id="@+id/text_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Egyenleg: 0 Ft"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:gravity="center"
            android:fontFamily="sans-serif"
            android:textColor="#212121"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- Műveleti gombok modern megjelenéssel -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Hozzáadás"
        app:layout_constraintTop_toBottomOf="@id/card_balance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_subtract"
        android:textAllCaps="false"
        android:textColor="#4FC3F7"
        android:fontFamily="sans-serif-medium"
        app:strokeColor="#4FC3F7"
        app:strokeWidth="2dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_subtract"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Levonás"
        app:layout_constraintTop_toBottomOf="@id/card_balance"
        app:layout_constraintStart_toEndOf="@id/btn_add"
        app:layout_constraintEnd_toEndOf="parent"
        android:textAllCaps="false"
        android:textColor="#4FC3F7"
        android:fontFamily="sans-serif-medium"
        app:strokeColor="#4FC3F7"
        app:strokeWidth="2dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
