<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fő összeg megjelenítése -->
    <TextView
        android:id="@+id/osszegTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fő összeg: 100000 Ft"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/nevEditText"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Név bevitel mező -->
    <EditText
        android:id="@+id/nevEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Kifizetés neve"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:textColor="#333333"
        android:hintTextColor="#888888"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/osszegTextView"
        app:layout_constraintBottom_toTopOf="@id/osszegEditText"/>

    <!-- Összeg bevitel mező -->
    <EditText
        android:id="@+id/osszegEditText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Kifizetés összege"
        android:inputType="numberDecimal"
        android:background="@android:drawable/editbox_background"
        android:padding="12dp"
        android:textColor="#333333"
        android:hintTextColor="#888888"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nevEditText"
        app:layout_constraintBottom_toTopOf="@id/hozzaadButton"/>

    <!-- Kifizetés hozzáadása gomb -->
    <Button
        android:id="@+id/hozzaadButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Hozzáadás"
        android:backgroundTint="#009bff"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/osszegEditText"
        app:layout_constraintBottom_toTopOf="@id/megjelenitButton"/>

    <!-- Kifizetések megjelenítése gomb -->
    <Button
        android:id="@+id/megjelenitButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kifizetések megjelenítése"
        android:backgroundTint="#009bff"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hozzaadButton"
        app:layout_constraintBottom_toTopOf="@id/kifizetesekTextView"/>

    <!-- Kifizetések lista -->
    <TextView
        android:id="@+id/kifizetesekTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nincsenek megjeleníthető kifizetések"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/megjelenitButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Kifizetés törlése gomb -->
    <Button
        android:id="@+id/torlesButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kifizetés törlése"
        android:backgroundTint="#009bff"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/kifizetesekTextView"/>

</androidx.constraintlayout.widget.ConstraintLayout>