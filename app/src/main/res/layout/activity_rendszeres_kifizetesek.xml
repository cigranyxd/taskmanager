<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#E1F5FE"
    tools:context=".YourActivity">

    <!-- Modern legördülő menü (Exposed Dropdown) a képernyő tetején -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:id="@+id/lenyilo_menu_layout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/lenyilo_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Navigáció" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Fő összeg kijelzése, a navigáció alatt -->
    <TextView
        android:id="@+id/osszegTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Fő összeg: 100000 Ft"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/lenyilo_menu_layout"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Név beviteli mező (MaterialTextInputLayout) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/nevInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/osszegTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/nevEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kifizetés neve"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Összeg beviteli mező (MaterialTextInputLayout) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/osszegInputLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusBottomEnd="8dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/nevInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/osszegEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Összeg (Ft)"
            android:inputType="numberDecimal" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Hozzáadás gomb (MaterialButton) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/hozzaadButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hozzáadás"
        android:layout_marginBottom="16dp"
        app:backgroundTint="#4FC3F7"
        android:textColor="#FFFFFF"
        app:cornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/osszegInputLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Kijelöltek törlése gomb (MaterialButton, igazi piros stílussal) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/torlesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kijelöltek törlése"
        android:layout_marginBottom="16dp"
        app:backgroundTint="#D32F2F"
        android:textColor="#FFFFFF"
        app:icon="@android:drawable/ic_menu_delete"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:cornerRadius="16dp"
        android:elevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/hozzaadButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Kifizetések lista (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/torlesButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
